NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT_MS=5000
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=
ALLOW_PRIVATE_NETWORK_ORIGINS=false
CHATBOT_ENABLED=true
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=replace_with_openai_model
CHATBOT_RAG_ENABLED=false
CHATBOT_DOCUMENT_INDEX_PATH=var/chatbot-documents/index.json
REMINDER_WORKER_ENABLED=true
MAIL_DELIVERY_ENABLED=false
GOVERNMENT_AUTOMATIONS_ENABLED=false
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
# Solo para una inicialización autorizada de staging; dejar vacío normalmente.
STAGING_ADMIN_INIT_ENABLED=false
STAGING_ADMIN_PASSWORD_HASH=
WORKER_LOCK_TTL_MS=120000
WORKER_LOCK_RENEWAL_MS=30000
REMINDER_RETRY_DELAY_SECONDS=60
WORKER_INTERVAL_MS=60000
SHUTDOWN_TIMEOUT_MS=15000
CAPSOLVER_API_KEY=replace_with_capsolver_api_key

DB_HOST=localhost
DB_PORT=3306
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=replace_with_database_name
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL_MODE=disabled
DB_TIMEZONE=-06:00

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM=Mototec <replace_with_authorized_sender>
