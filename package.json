{
  "name": "Back-Preventive-Bot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "chatbot:index-documents": "tsx scripts/index-chatbot-documents.ts",
    "chatbot:evaluate-intents": "tsx scripts/evaluate-chatbot-intents.ts",
    "chatbot:evaluate-classification-fixes": "tsx scripts/evaluate-chatbot-classification-fixes.ts",
    "chatbot:evaluate-customer-fixes": "tsx scripts/evaluate-chatbot-customer-fixes.ts",
    "seed:maintenance-demo": "tsx scripts/seed-maintenance-demo.ts",
    "seed:service-catalog": "tsx scripts/seed-service-catalog.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10.18.3 <11"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@playwright/test": "^1.62.1",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "nodemailer": "^10.0.16",
    "openai": "^7.23.0",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
